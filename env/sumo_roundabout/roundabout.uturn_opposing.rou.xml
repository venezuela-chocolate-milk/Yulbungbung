<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-17: 엄마 경로 유턴(SW_long_uturn)에서 마주 오는 방향(SW_end_T_left_out) 교통 추가.
     그 방향 차들이 오는 진입로(SW_final_right_in, S_cross 쪽)는 다른 교차로에서 이미 포화라 배율을 올려도 늘지 않아,
     유턴 바로 앞 도로에서 출발하는 흐름(옆길·건물에서 나오는 차)을 둔다. 양은 traffic_tune.py 가 이 그룹 배율로 정한다
     (파일 값 × 0.8 × 배율). 목적지는 서곶로 × 원당대로 사거리 직진·좌회전·우회전으로 나눔. -->
<routes>
    <flow id="uo_cross" type="car" from="SW_end_T_left_out" to="SW_new_cross_out" begin="0" end="100000" vehsPerHour="150" departLane="random" departPos="base" departSpeed="max"/>
    <flow id="uo_upper" type="car" from="SW_end_T_left_out" to="SW_new_upper_out" begin="0" end="100000" vehsPerHour="50" departLane="random" departPos="base" departSpeed="max"/>
    <flow id="uo_lower" type="car" from="SW_end_T_left_out" to="SW_new_lower_out" begin="0" end="100000" vehsPerHour="50" departLane="random" departPos="base" departSpeed="max"/>
</routes>
